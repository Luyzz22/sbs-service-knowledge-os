COMPOSE_PROJECT_NAME=sbs-service-knowledge-os

# Container image published by the CI workflow.
APP_IMAGE=ghcr.io/luyzz22/sbs-service-knowledge-os
APP_IMAGE_TAG=latest

# Public routing and Let's Encrypt.
APP_HOST=knowledge.example.com
ACME_EMAIL=operations@example.com
DEPLOY_HEALTHCHECK_URL=https://knowledge.example.com/_stcore/health

# Application secrets are mounted as files; never put their values here.
OPENAI_API_KEY_FILE=./secrets/openai_api_key
LLAMA_CLOUD_API_KEY_FILE=./secrets/llama_cloud_api_key

# PostgreSQL. Point POSTGRES_DATA_DIR at the mounted Hetzner block volume.
POSTGRES_DB=sbs_knowledge_os
POSTGRES_USER=sbs_app
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
POSTGRES_DATA_DIR=./data/postgres
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_MAX_WAL_SIZE=2GB

# Qdrant must use local block storage, not NFS or object storage.
QDRANT_DATA_DIR=./data/qdrant

# Encrypted off-site PostgreSQL backups through restic and S3-compatible storage.
BACKUP_ENABLED=false
BACKUP_INTERVAL_SECONDS=86400
BACKUP_WORK_DIR=./backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
RESTIC_REPOSITORY=s3:https://fsn1.your-objectstorage.com/sbs-knowledge-os-backups
RESTIC_PASSWORD_FILE=./secrets/restic_password
S3_ACCESS_KEY_ID_FILE=./secrets/s3_access_key_id
S3_SECRET_ACCESS_KEY_FILE=./secrets/s3_secret_access_key
