# HydraulikDoc local/private-edge profile. Production values are deployed via Azure IaC.
APP_ENV=development
AUTH_MODE=local
AI_BACKEND=disabled
PERSISTENCE_BACKEND=memory
DEFAULT_TENANT_ID=development-tenant
PUBLIC_BASE_URL=https://knowledge.example.de

# Local users must be Argon2id hashes. Prefer LOCAL_USERS_JSON_FILE.
LOCAL_USERS_JSON_FILE=./secrets/local_users_json
AUDIT_HMAC_KEY_FILE=./secrets/audit_hmac_key
SESSION_IDLE_MINUTES=30

# Application data limits and human oversight.
MAX_UPLOAD_BYTES=52428800
MAX_QUESTION_CHARS=2000
MAX_VIDEO_BYTES=209715200
MALWARE_SCAN_TIMEOUT_SECONDS=300
REQUIRE_HUMAN_REVIEW=true
ENABLE_AZURE_MULTIMODAL=false
PRIVACY_NOTICE_VERSION=2026-08-14
AI_NOTICE_VERSION=2026-08-14

# Azure production profile (enable AI_BACKEND=azure only when complete).
AZURE_REGION=germanywestcentral
AZURE_USE_MANAGED_IDENTITY=true
AZURE_OPENAI_ENDPOINT=https://replace-me.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=hydraulikdoc-chat
AZURE_OPENAI_MODEL_SNAPSHOT=deployment-defined
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=hydraulikdoc-embedding
AZURE_EMBEDDING_DIMENSIONS=1536
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://replace-me.cognitiveservices.azure.com
AZURE_SEARCH_ENDPOINT=https://replace-me.search.windows.net
AZURE_SEARCH_INDEX=hydraulikdoc-knowledge-v1
AZURE_SEARCH_SEMANTIC=true
AZURE_BLOB_ENDPOINT=https://replace-me.blob.core.windows.net
AZURE_BLOB_CONTAINER=documents

# PostgreSQL. Prefer DATABASE_PASSWORD_FILE outside Azure.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=hydraulikdoc
DATABASE_USER=hydraulikdoc_app
DATABASE_PASSWORD_FILE=./secrets/postgres_password
DATABASE_SSLMODE=prefer
AUTO_MIGRATE_DATABASE=true

# Production release gates. Never set true without signed deployment evidence.
COMPLIANCE_RELEASE_APPROVED=false
DEPLOYMENT_EVIDENCE_ID=
AI_EVALUATION_EVIDENCE_ID=
RETENTION_POLICY_APPROVED=false
RETENTION_POLICY_ID=

# Technical retention values. Approval must match the processing register.
AI_INTERACTION_RETENTION_DAYS=90
AUDIT_EVENT_RETENTION_DAYS=730
CONTRACT_ACCEPTANCE_RETENTION_DAYS=3650
DATA_SUBJECT_REQUEST_RETENTION_DAYS=1095
INCIDENT_RETENTION_DAYS=730
UPLOADED_CONTENT_RETENTION_DAYS=365

# Existing private-edge Compose deployment.
COMPOSE_PROJECT_NAME=hydraulikdoc
APP_IMAGE=ghcr.io/luyzz22/sbs-service-knowledge-os
APP_IMAGE_TAG=latest
APP_HOST=knowledge.example.de
ACME_EMAIL=operations@example.de
DEPLOY_HEALTHCHECK_URL=https://knowledge.example.de/_stcore/health
POSTGRES_DB=hydraulikdoc
POSTGRES_USER=hydraulikdoc_app
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
POSTGRES_DATA_DIR=./data/postgres
BACKUP_ENABLED=false
BACKUP_INTERVAL_SECONDS=86400
BACKUP_WORK_DIR=./backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
RESTIC_REPOSITORY=s3:https://fsn1.your-objectstorage.com/hydraulikdoc-backups
RESTIC_PASSWORD_FILE=./secrets/restic_password
S3_ACCESS_KEY_ID_FILE=./secrets/s3_access_key_id
S3_SECRET_ACCESS_KEY_FILE=./secrets/s3_secret_access_key
