{
  "name": "HydraulikDoc Enterprise (Python 3.11)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "python -m pip install --require-hashes --requirement requirements-dev.lock",
  "postAttachCommand": {
    "server": "streamlit run app.py --server.enableCORS true --server.enableXsrfProtection true"
  },
  "portsAttributes": {
    "8501": {
      "label": "HydraulikDoc",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
